libdir=/work/src/dist/linux-x64-shared-debug/gtest/lib
includedir=/work/src/dist/linux-x64-shared-debug/gtest/include

Name: gmock
Description: GoogleMock (without main() function)
Version: 1.15.2
URL: https://github.com/google/googletest
Requires: gtest = 1.15.2
Libs: -L${libdir} -lgmock -lpthread
Cflags: -I${includedir} -DGTEST_HAS_PTHREAD=1
