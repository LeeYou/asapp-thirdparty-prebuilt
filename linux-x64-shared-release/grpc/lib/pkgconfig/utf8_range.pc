prefix=/work/src/dist/linux-x64-shared-release/grpc
exec_prefix=/work/src/dist/linux-x64-shared-release/grpc
libdir=/work/src/dist/linux-x64-shared-release/grpc/lib
includedir=/work/src/dist/linux-x64-shared-release/grpc/include

Name: UTF8 Range
Description: Google's UTF8 Library
Version: 1.0
Requires: absl_strings
Libs: -L${libdir} -lutf8_validity -lutf8_range -pthread
Cflags: -I${includedir}
