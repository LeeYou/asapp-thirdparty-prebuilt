prefix=/work/src/dist/linux-x64-shared-release/grpc
exec_prefix=${prefix}
libdir=/work/src/dist/linux-x64-shared-release/grpc/lib
includedir=/work/src/dist/linux-x64-shared-release/grpc/include

Name: absl_flags_path_util
Description: Abseil flags_path_util library
URL: https://abseil.io/
Version: 20240116
Requires: absl_config = 20240116, absl_strings = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
