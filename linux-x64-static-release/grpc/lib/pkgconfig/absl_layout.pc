prefix=/work/src/dist/linux-x64-static-release/grpc
exec_prefix=${prefix}
libdir=/work/src/dist/linux-x64-static-release/grpc/lib
includedir=/work/src/dist/linux-x64-static-release/grpc/include

Name: absl_layout
Description: Abseil layout library
URL: https://abseil.io/
Version: 20240116
Requires: absl_config = 20240116, absl_core_headers = 20240116, absl_debugging_internal = 20240116, absl_meta = 20240116, absl_strings = 20240116, absl_span = 20240116, absl_utility = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
