prefix=/work/src/dist/linux-x64-static-debug/libffi
exec_prefix=${prefix}
libdir=/work/src/dist/linux-x64-static-debug/libffi/lib
toolexeclibdir=${libdir}
includedir=${prefix}/include

Name: libffi
Description: Library supporting Foreign Function Interfaces
Version: 3.4.6
Libs: -L${toolexeclibdir} -lffi
Cflags: -I${includedir}
