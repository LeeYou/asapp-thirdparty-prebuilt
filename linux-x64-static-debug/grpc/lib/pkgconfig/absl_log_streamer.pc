prefix=/work/src/dist/linux-x64-static-debug/grpc
exec_prefix=${prefix}
libdir=/work/src/dist/linux-x64-static-debug/grpc/lib
includedir=/work/src/dist/linux-x64-static-debug/grpc/include

Name: absl_log_streamer
Description: Abseil log_streamer library
URL: https://abseil.io/
Version: 20240116
Requires: absl_config = 20240116, absl_absl_log = 20240116, absl_log_severity = 20240116, absl_optional = 20240116, absl_strings = 20240116, absl_strings_internal = 20240116, absl_utility = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
