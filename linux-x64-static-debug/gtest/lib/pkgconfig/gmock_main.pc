libdir=/work/src/dist/linux-x64-static-debug/gtest/lib
includedir=/work/src/dist/linux-x64-static-debug/gtest/include

Name: gmock_main
Description: GoogleMock (with main() function)
Version: 1.15.2
URL: https://github.com/google/googletest
Requires: gmock = 1.15.2
Libs: -L${libdir} -lgmock_main -lpthread
Cflags: -I${includedir} -DGTEST_HAS_PTHREAD=1
